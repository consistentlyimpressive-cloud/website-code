{
  "name": "gemini-results-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "MogCheck — React frontend + Express API",
  "homepage": "https://www.mogcheck.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consistentlyimpressive-cloud/website-code.git"
  },
  "bugs": {
    "url": "https://github.com/consistentlyimpressive-cloud/website-code/issues"
  },
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "concurrently -n fs,api,web -c yellow,cyan,magenta \"firebase emulators:start --only firestore --project demo-mogcheck\" \"wait-on tcp:8080 && cross-env USE_FIREBASE_EMULATOR=1 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 npm --prefix backend run dev\" \"wait-on tcp:8080 && vite --port 5174 --strictPort\"",
    "dev:no-emulator": "npm run dev:api-web-only",
    "dev:live": "npm run dev:api-web-only",
    "dev:api-web-only": "concurrently -n api,web -c cyan,magenta \"npm --prefix backend run dev\" \"vite --port 5174 --strictPort\"",
    "dev:web": "vite --port 5174 --strictPort",
    "dev:api": "npm --prefix backend run dev",
    "dev:stack": "npm run dev",
    "setup:local": "node scripts/setup-local.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "firebase": "^12.11.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^13.29.1",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.1",
    "wait-on": "^8.0.1"
  }
}

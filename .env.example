# Frontend (Vite) — copy to .env.local for local dev, or set in Vercel/hosting dashboard.

# Backend API base URL (no trailing slash). On Vercel (HTTPS) use https:// only — http:// is blocked (mixed content).
#
# Local dev: leave unset or use http://localhost:3001 — the app uses same-origin /api/… and Vite proxies to :3001
# (see vite.config.js). Set VITE_API_URL=https://YOUR.trycloudflare.com only if you want the local UI to hit a remote API.
VITE_API_URL=http://localhost:3001

# Paddle checkout (frontend-safe values)
# Use production for mogcheck.net. Use sandbox for localhost checkout testing.
VITE_PADDLE_ENV=production
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_SINGLE_SCAN=
VITE_PADDLE_PRICE_PRO=

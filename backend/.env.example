# Copy to .env and fill in values. Never commit .env.
#
# Local dev (npm run dev from repo root): Firestore emulator runs on 8080 — npm injects
# USE_FIREBASE_EMULATOR=1 and FIRESTORE_EMULATOR_HOST for the backend. You do NOT need FIREBASE_SERVICE_ACCOUNT_JSON
# for Mog Battle voting (Admin SDK talks to the emulator).
#
# Production / dev without emulator: set FIREBASE_SERVICE_ACCOUNT_JSON for Firestore + Auth verify.

PORT=3001
NODE_ENV=development

# Comma-separated origins for browser requests (frontend URL). Example:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://localhost:5174
# Vite dev uses port 5174 in this repo — include it or the browser will block vote API calls.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001

# Public URL of this API (no trailing slash). Used for loading_scan.mp4 when LOADING_VIDEO_URL is unset.
# In production: https://api.yourdomain.com
PUBLIC_BACKEND_URL=http://localhost:3001

# Optional: full URL to loading scan MP4 (e.g. CDN). If unset, uses PUBLIC_BACKEND_URL + /loading_scan.mp4
# LOADING_VIDEO_URL=https://cdn.yourdomain.com/media/loading_scan.mp4

# Admin dashboard password (change from default!)
ADMIN_PASSWORD=change-me-strong-password

# Paddle webhook signing secret (from Paddle > Developer Tools > Notifications)
PADDLE_WEBHOOK_SECRET=

# Paddle price IDs used by the webhook to map purchases to MogCheck plans
PADDLE_PRICE_SINGLE_SCAN=pri_01kph4qjjrtbdbnswrvdt16jkn
PADDLE_PRICE_PRO=pri_01kph4pr6xpxhq7c4jfztdmr44
PADDLE_PRICE_PRO_YEARLY=pri_01kq54g14he2zakyxr0nrt1ckc

# --- Firebase (production) ---
# Paste the full JSON of the service account key as a single line (Railway/Render env var).
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=
#
# Local dev without pasting JSON: install Google Cloud CLI, then run:
#   gcloud auth application-default login
# That creates Application Default Credentials so Firestore + Admin SDK work with the same projectId above.
# Or set GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Optional overrides
# FIREBASE_PROJECT_ID=mogcheck-net
# FIREBASE_STORAGE_BUCKET=mogcheck-net.firebasestorage.app
# USE_FIREBASE_EMULATOR=1
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Admin analytics: use Firestore (default when Firebase works) or file-only for local dev
# ADMIN_DATA_SOURCE=file

# After analysis, upload images to Firebase Storage and delete local copies (optional)
# UPLOAD_TO_FIREBASE_STORAGE=true

# Python: override auto-detected venv path (Docker/Linux uses PYTHON_PATH in Dockerfile)
# PYTHON_PATH=/opt/venv/bin/python3

# API keys for Python engines (final_engine.py, etc.)
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
OPENROUTER_API_KEY=
OPENROUTER_QWEN_TEST_MODEL_ID=qwen/qwen2.5-vl-72b-instruct
OPENROUTER_HAIIII_API_KEY=
OPENROUTER_FINAL_BOSS=
OPENROUTER_HAIIII_MODEL_ID=google/gemma-4-31b-it
KIMI_API_KEY=

# Mog Battles: Firebase Auth emails that may vote multiple times (comma-separated, case-insensitive)
# MOG_BATTLE_ADMIN_EMAILS=you@gmail.com,other@example.com
# MOG_BATTLE_VOTE_RATE_MAX=25

# Rate limits (optional; /api/analyze and /api/unlock-potential only)
# ANALYZE_RATE_LIMIT_MAX=40
# UNLOCK_RATE_LIMIT_MAX=30

# Debug log endpoint: in production requires DEBUG_LOG_TOKEN and header x-debug-token
# DEBUG_LOG_TOKEN=
# DEBUG_LOG_RATE_LIMIT_MAX=20

# Max upload size in bytes (default 15MB)
# UPLOAD_MAX_BYTES=15728640
